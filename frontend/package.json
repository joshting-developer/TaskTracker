{
  "name": "tasktracker-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node tools/browser-check.js",
    "test:smoke": "npm run test:routes && npm run test:api && npm run test:composables && npm run build && node tools/sidebar-links-check.js",
    "test:composables": "node tools/refactor-composables-check.js",
    "test:routes": "node tools/hash-routes-check.js",
    "test:markdown": "node tools/markdown-check.js",
    "test:settings": "node tools/account-settings-check.js",
    "test:board": "node tools/board-ux-check.js",
    "test:realtime": "node tools/realtime-check.js",
    "test:home": "node tools/home-check.js",
    "test:issue-time": "node tools/issue-time-check.js",
    "test:time-analysis": "node tools/time-analysis-check.js",
    "test:member-time": "node tools/member-time-details-check.js",
    "test:workspaces": "node tools/workspace-switch-check.js",
    "test:tokens": "node tools/personal-tokens-check.js",
    "test:api": "node tools/api-client-check.js",
    "test:bundle": "node tools/bundle-check.js",
    "test:docs": "node tools/developer-docs-check.js",
    "test:visual": "cd .. && sh tools/visual-check.sh compare",
    "test:visual:candidate": "cd .. && sh tools/visual-check.sh candidate",
    "test:visual:prove": "cd .. && sh tools/visual-check.sh prove"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "pusher-js": "8.6.0",
    "vue": "3.5.43",
    "vuetify": "4.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-vue": "6.0.9",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-vuetify": "2.1.3"
  }
}
