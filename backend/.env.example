APP_NAME=TaskTracker
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:5174

APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tasktracker
DB_USERNAME=tasktracker
DB_PASSWORD_FILE=/run/tasktracker-app/password
# 原生PHP可自行設定DB_HOST與DB_PASSWORD，勿提交實際密碼

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 完整Compose使用reverb；單獨啟動須先設定Reverb金鑰與服務
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175
REVERB_APP_ID=tasktracker
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost
REVERB_SCALING_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 本機示範 seed 密碼, 不提供公開預設值；實際值請放被忽略的環境設定
TASKTRACKER_SEED_PASSWORD=

# Private Issue images; choose r2-attachments only after configuring the private bucket
ATTACHMENTS_DISK=attachments
ATTACHMENTS_LOCAL_ROOT=
ATTACHMENTS_MAX_BYTES=10485760
ATTACHMENTS_MAX_PIXELS=25000000
ATTACHMENTS_PER_ISSUE=20
ATTACHMENTS_PENDING_PER_USER=20
ATTACHMENTS_WORKSPACE_BYTES=1073741824
ATTACHMENTS_PENDING_HOURS=24
ATTACHMENTS_RETENTION_DAYS=30
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_CONNECT_TIMEOUT=3
R2_TIMEOUT=15

# Download-only PDF/ZIP quotas; images retain their own limit
ATTACHMENTS_GENERAL_MAX_BYTES=10485760
ATTACHMENTS_GENERAL_PER_ISSUE=10
ATTACHMENTS_GENERAL_WORKSPACE_BYTES=268435456

# External Redis: use tls + a mounted CA file; peer/name verification is always enabled.
REDIS_SCHEME=tcp
REDIS_SSL_CA=
REDIS_CONNECT_TIMEOUT=3
REDIS_READ_TIMEOUT=3
DB_CONNECT_TIMEOUT=3

# Omit to allow local/testing only; production defaults to invitation-only.
# TASKTRACKER_PUBLIC_REGISTRATION=false
