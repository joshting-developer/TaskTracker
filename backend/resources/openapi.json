            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "page",
                        "perPage",
                        "total",
                        "lastPage"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "$ref": "#/components/schemas/Token"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "perPage": {
                          "const": 20
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "lastPage": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "data": {
                    "items": [
                      {
                        "id": "42",
                        "name": "CLI example",
                        "abilities": [
                          "read"
                        ],
                        "createdAt": "2026-11-12T00:00:00Z",
                        "expiresAt": "2026-12-11T16:00:00Z",
                        "status": "active"
