  "components": {
    "securitySchemes": {
      "bearerPat": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tasktracker_session"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "Token": {
        "type": "object",
        "required": [
          "id",
          "name",
          "abilities",
          "createdAt",
          "expiresAt",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "abilities": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write"
              ]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "active",
              "expired",
              "revoked"
            ]
          }
        }
      },
      "CreateToken": {
        "type": "object",
        "required": [
          "name",
          "abilities",
          "requestId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "\\S"
          },
          "abilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write"
              ]
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date",
            "description": "Asia/Taipei 00:00到期；省略預設一個月，最長兩年，不接受null"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "description": "只取已宣告欄位；未知欄位被忽略，不能用actor／workspace／role提權。requestId必填UUID；JSON物件最多50000 bytes。"
      },
      "Identity": {
        "type": "object",
        "required": [
          "userId",
          "workspaceId",
          "abilities"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "abilities": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write"
              ]
            }
          }
        }
      },
      "IntegrationAudit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "userId",
          "source",
          "tokenId",
          "tokenName",
          "abilities",
          "operation",
          "resourceId",
          "occurredAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "session",
              "token"
            ]
          },
          "tokenId": {
            "type": [
              "string",
              "null"
            ]
          },
          "tokenName": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 60
          },
          "abilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "write"
              ]
            }
          },
          "operation": {
            "type": "string",
            "maxLength": 80
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "headers": {
      "RetryAfter": {
        "description": "429後至少等待的秒數；等待後以相同requestId重試寫入",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "RateLimit": {
        "description": "目前操作所屬時間窗的請求上限",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "RateRemaining": {
        "description": "目前時間窗剩餘請求數",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "RateReset": {
        "description": "429計數重設的Unix秒數",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "tags": [
    {
      "name": "Identity",
      "description": "公開Bearer身分，固定Token Workspace"
    },
    {
      "name": "Personal tokens",
      "description": "僅Session的個人憑證及來源管理，不接受PAT作替代"
    }
  ],
