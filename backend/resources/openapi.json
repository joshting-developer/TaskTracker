              }
            }
          },
          "400": {
            "description": "輸入無效",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "properties": {
                        "error": {
                          "properties": {
                            "code": {
                              "enum": [
                                "INVALID_INPUT"
                              ]
                            }
                          }
                        }
                      }
                    }
                  ]
                },
                "example": {
                  "ok": false,
                  "error": {
                    "code": "INVALID_INPUT",
                    "message": "輸入無效"
