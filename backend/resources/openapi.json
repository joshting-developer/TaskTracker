{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskTracker API",
    "version": "0.1.0",
    "description": "TT-165 PAT第一階段。Token管理僅瀏覽器Session／CSRF；公開業務CRUD尚未交付，現有RPC不接受PAT。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/personal-tokens": {
      "get": {
        "operationId": "listPersonalTokens",
        "summary": "本人目前工作區Token分頁（Session）",
        "tags": [
          "Personal tokens"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "page",
                        "perPage",
                        "total",
                        "lastPage"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "$ref": "#/components/schemas/Token"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "perPage": {
                          "const": 20
                        },
                        "total": {
                          "type": "integer"
                        },
                        "lastPage": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "輸入不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登入或Token無效／過期／撤銷／資格失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope或來源不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "找不到本人Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Workspace已切換或相同建立requestId已使用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "Session CSRF過期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "請求過於頻繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "in": "header",
            "name": "X-Workspace-ID",
            "schema": {
              "type": "string"
            },
            "description": "建議提供，與Session目前工作區不同則409；不是指定可任意操作的Workspace"
          }
        ]
      },
      "post": {
        "operationId": "createPersonalToken",
        "summary": "建立原文僅顯示一次的PAT（Session＋CSRF）",
        "tags": [
          "Personal tokens"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "token",
                        "plainTextToken"
                      ],
                      "properties": {
                        "token": {
                          "$ref": "#/components/schemas/Token"
                        },
                        "plainTextToken": {
                          "type": "string",
                          "writeOnly": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "輸入不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登入或Token無效／過期／撤銷／資格失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope或來源不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "找不到本人Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Workspace已切換或相同建立requestId已使用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "Session CSRF過期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "請求過於頻繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateToken"
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-Workspace-ID",
            "schema": {
              "type": "string"
            },
            "description": "建議提供，與Session目前工作區不同則409；不是指定可任意操作的Workspace"
          }
        ]
      }
    },
    "/api/v1/personal-tokens/{token}/revoke": {
      "post": {
        "operationId": "revokePersonalToken",
        "summary": "撤銷本人Token，重複撤銷不再異動",
        "tags": [
          "Personal tokens"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Token"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "輸入不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登入或Token無效／過期／撤銷／資格失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope或來源不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "找不到本人Token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Workspace已切換或相同建立requestId已使用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "Session CSRF過期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "請求過於頻繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          {
            "in": "header",
            "name": "X-Workspace-ID",
            "schema": {
              "type": "string"
            },
            "description": "建議提供，與Session目前工作區不同則409；不是指定可任意操作的Workspace"
          }
        ]
      }
    },
    "/api/public/v1/me": {
      "get": {
        "operationId": "getTokenIdentity",
        "summary": "以Bearer驗證Token固定工作區資格，write隱含read",
        "tags": [
          "Public API"
        ],
        "security": [
          {
            "bearerPat": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Identity"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "輸入不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "未登入或Token無效／過期／撤銷／資格失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Scope或來源不足",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "請求過於頻繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerPat": {
        "type": "http",
        "scheme": "bearer"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tasktracker_session"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Token": {
        "type": "object",
        "required": [
          "id",
          "name",
          "abilities",
          "createdAt",
          "expiresAt",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "abilities": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write"
              ]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "active",
              "expired",
              "revoked"
            ]
          }
        }
      },
      "CreateToken": {
        "type": "object",
        "required": [
          "name",
          "abilities",
          "requestId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "abilities": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "read",
                "write"
              ]
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date",
            "description": "Asia/Taipei 00:00到期；省略預設一個月，最長兩年，不接受null"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Identity": {
        "type": "object",
        "required": [
          "userId",
          "workspaceId",
          "abilities"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "workspaceId": {
            "type": "string"
          },
          "abilities": {
            "type": "array",
            "items": {
              "enum": [
                "read",
                "write"
              ]
            }
          }
        }
      }
    }
  }
}
