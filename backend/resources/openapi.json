{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskTracker API",
    "version": "0.2.0",
    "description": "已實作的公開Bearer v1與Session個人憑證管理契約。只列可呼叫操作；卡片／專案公開REST尚待TT-168／169。Session入口不是第三方PAT業務API。 [HTTP契約](/api/public/contract.md)。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
