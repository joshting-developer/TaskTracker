{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskTracker Session Authentication",
    "version": "1.3.0",
    "description": "Session and CSRF only; not the PAT API. Legacy accounts keep their existing eligibility. New registration requires verification. Activation GET only renders the page, with token in URL fragment."
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Create a new account, always pending verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  },
                  "workspaceName": {
                    "type": "string"
                  },
                  "inviteToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PendingVerification"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          },
          "403": {
            "description": "FORBIDDEN: public signup is closed and no valid invitation was supplied"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "description": "Public signup is rejected with 403 when TASKTRACKER_PUBLIC_REGISTRATION is false. A valid, unconsumed, matching-email invitation remains allowed and new accounts still require email verification."
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate credentials; new unverified accounts return pending state",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "inviteToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SessionIdentity"
                        },
                        {
                          "$ref": "#/components/schemas/PendingVerification"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/current": {
      "post": {
        "summary": "Read authenticated identity or resume pending verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SessionIdentity"
                        },
                        {
                          "$ref": "#/components/schemas/PendingVerification"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/verify-email": {
      "post": {
        "summary": "Consume a single-use activation token by explicit POST",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SessionIdentity"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/resend-verification": {
      "post": {
        "summary": "Replace current challenge; optionally change the pending email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PendingVerification"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/registration-policy": {
      "get": {
        "summary": "Read invitation-only/public signup policy without a session or database query",
        "responses": {
          "200": {
            "description": "Only the public signup capability; no email allowlist or secrets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "publicRegistration"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "publicRegistration": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rpc/inviteMember": {
      "post": {
        "summary": "Invite an address by transactional email; no membership before acceptance",
        "description": "Session + CSRF, workspace.invite required before replay. Same requestId and exact payload replays the original result without another invitation/email. Different payload is 409. New request for the same email expires the previous link. Token-containing receipt is encrypted. 10/minute in local/production. Expires in 7 days. Legacy missing requestId remains one-shot. No automatic resend after uncertain delivery.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "requestId": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON response, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "token",
                        "email",
                        "expiresAt"
                      ],
                      "properties": {
                        "token": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "401": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "403": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "409": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "429": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          }
        }
      }
    },
    "/api/v1/workspace/invitations": {
      "get": {
        "summary": "Read this workspace pending, unexpired invitations only",
        "description": "Session-only, workspace.invite required. SQL pagination, stable expiresAt DESC and internal id DESC; no token, mail body, receipt or workspace snapshot. Accepted/expired invitations disappear. Member directory is separate.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "page",
                        "perPage",
                        "total",
                        "lastPage"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "email",
                              "role",
                              "createdAt",
                              "expiresAt",
                              "deliveryStatus"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Opaque invitation identifier, never the secret token"
                              },
                              "email": {
                                "type": "string",
                                "format": "email"
                              },
                              "role": {
                                "const": "user"
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "expiresAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "deliveryStatus": {
                                "enum": [
                                  "pending",
                                  "sending",
                                  "sent",
                                  "failed",
                                  "uncertain",
                                  "skipped",
                                  "unavailable"
                                ]
                              }
                            }
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "perPage": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "lastPage": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "401": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "403": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "409": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tasktracker_session"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-TOKEN"
      }
    },
    "schemas": {
      "PendingVerification": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verificationRequired",
          "email",
          "expiresAt",
          "resendAt",
          "resendAfterSeconds",
          "deliveryStatus"
        ],
        "properties": {
          "verificationRequired": {
            "const": true
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAt": {
            "type": "string",
            "format": "date-time"
          },
          "resendAfterSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60
          },
          "deliveryStatus": {
            "type": "string",
            "enum": [
              "pending",
              "sending",
              "sent",
              "failed",
              "uncertain",
              "skipped"
            ],
            "description": "當次驗證的寄送狀態, 失敗可在冷卻後明確重寄, 不回傳內部錯誤或信件秘密"
          }
        }
      },
      "SessionIdentity": {
        "type": "object",
        "required": [
          "user",
          "workspace",
          "role",
          "permissions"
        ],
        "properties": {
          "user": {
            "type": "object"
          },
          "workspace": {
            "type": "object"
          },
          "role": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
