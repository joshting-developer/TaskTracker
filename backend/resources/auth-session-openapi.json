{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskTracker Session Authentication",
    "version": "1.7.0",
    "description": "Session and CSRF only; not the PAT API. Legacy accounts keep their existing eligibility. New public registration requires an activation link; valid invitations verify the exact invited email during new-account registration. Activation GET only renders the page, with token in URL fragment. A verified account may have no active workspace; workspace and role are then null and permissions is empty. Workspace APIs still require active membership."
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Create a new account, always pending verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  },
                  "workspaceName": {
                    "type": "string"
                  },
                  "inviteToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PendingVerification"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          },
          "403": {
            "description": "FORBIDDEN: public signup is closed and no valid invitation was supplied"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "description": "Public signup is rejected with 403 when TASKTRACKER_PUBLIC_REGISTRATION is false. A valid, unconsumed, matching-email invitation remains allowed and new invited accounts verify only the exact invited email using this single-use invitation; no second activation email. Public signup still requires a separate activation link."
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate credentials; new unverified accounts return pending state",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "inviteToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SessionIdentity"
                        },
                        {
                          "$ref": "#/components/schemas/PendingVerification"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/current": {
      "post": {
        "summary": "Read authenticated identity or resume pending verification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "oneOf": [
                        {
                          "$ref": "#/components/schemas/SessionIdentity"
                        },
                        {
                          "$ref": "#/components/schemas/PendingVerification"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/verify-email": {
      "post": {
        "summary": "Consume a single-use activation token by explicit POST",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/SessionIdentity"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/resend-verification": {
      "post": {
        "summary": "Replace current challenge; optionally change the pending email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session result, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/PendingVerification"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, expired, consumed credential, attempt limit or cooldown"
          },
          "401": {
            "description": "Pending/authenticated session required"
          },
          "409": {
            "description": "Email already registered"
          },
          "419": {
            "description": "CSRF expired or missing"
          },
          "429": {
            "description": "Rate limit, honor Retry-After"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ]
      }
    },
    "/api/auth/registration-policy": {
      "get": {
        "summary": "Read invitation-only/public signup policy without a session or database query",
        "responses": {
          "200": {
            "description": "Only the public signup capability; no email allowlist or secrets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "publicRegistration"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "publicRegistration": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/rpc/inviteMember": {
      "post": {
        "summary": "Invite an address by transactional email; no membership before acceptance",
        "description": "Session + CSRF, workspace.invite required before replay. Same requestId and exact payload replays the original result without another invitation/email. Different payload is 409. New request for the same email expires the previous link. Token-containing receipt is encrypted. 10/minute in local/production. Expires in 7 days. Legacy missing requestId remains one-shot. No automatic resend after uncertain delivery.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "requestId": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON response, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "token",
                        "email",
                        "expiresAt"
                      ],
                      "properties": {
                        "token": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "401": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "403": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "409": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "429": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          }
        }
      }
    },
    "/api/v1/workspace/invitations": {
      "get": {
        "summary": "Read this workspace pending, unexpired invitations only",
        "description": "Session-only, workspace.invite required. SQL pagination, stable expiresAt DESC and internal id DESC; no token, mail body, receipt or workspace snapshot. Accepted/expired invitations disappear. Member directory is separate.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON response, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "page",
                        "perPage",
                        "total",
                        "lastPage"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "email",
                              "role",
                              "createdAt",
                              "expiresAt",
                              "deliveryStatus"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "description": "Opaque invitation identifier, never the secret token"
                              },
                              "email": {
                                "type": "string",
                                "format": "email"
                              },
                              "role": {
                                "const": "user"
                              },
                              "createdAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "expiresAt": {
                                "type": "string",
                                "format": "date-time"
                              },
                              "deliveryStatus": {
                                "enum": [
                                  "pending",
                                  "sending",
                                  "sent",
                                  "failed",
                                  "uncertain",
                                  "skipped",
                                  "unavailable"
                                ]
                              }
                            }
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "perPage": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "lastPage": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "401": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "403": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          },
          "409": {
            "description": "Invalid input, unauthorized, forbidden, stale workspace or request conflict"
          }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "summary": "Request password recovery without revealing account existence",
        "description": "Session/CSRF boundary, no PAT. Fixed APP_URL, token in fragment. Recovery expires after 30 minutes; 60-second per-account resend cooldown; replacement invalidates previous links. No automatic login or email verification. Existing legacy sessions remain valid until that account resets its password.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic accepted response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "accepted"
                      ],
                      "properties": {
                        "accepted": {
                          "const": true
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or invalid/expired/consumed reset link"
          },
          "419": {
            "description": "CSRF missing or expired"
          },
          "429": {
            "description": "Rate limit; honor Retry-After"
          }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "summary": "Consume single-use recovery credential and revoke old sessions and PATs",
        "description": "Session/CSRF boundary, no PAT. Fixed APP_URL, token in fragment. Recovery expires after 30 minutes; 60-second per-account resend cooldown; replacement invalidates previous links. No automatic login or email verification. Existing legacy sessions remain valid until that account resets its password.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "token",
                  "password",
                  "password_confirmation"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 254
                  },
                  "token": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  },
                  "password_confirmation": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password reset; authenticate again",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "reset"
                      ],
                      "properties": {
                        "reset": {
                          "const": true
                        }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or invalid/expired/consumed reset link"
          },
          "419": {
            "description": "CSRF missing or expired"
          },
          "429": {
            "description": "Rate limit; honor Retry-After"
          }
        }
      }
    },
    "/api/auth/createWorkspace": {
      "post": {
        "summary": "Create a workspace for the current eligible account without registering a second user",
        "description": "Session/CSRF only, 5 requests per minute. A current eligible member can create a workspace regardless of their role in other workspaces. The creator becomes owner and the session switches to the new workspace. User-scoped requestId replays the same creation; changed name conflicts. Replay requires active membership and never recreates a deleted workspace. Existing memberships are unchanged.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "workspaceName",
                  "requestId"
                ],
                "properties": {
                  "workspaceName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Current authenticated user, new workspace and effective owner permissions"
          },
          "400": {
            "description": "Invalid name or requestId"
          },
          "401": {
            "description": "Missing or expired session"
          },
          "403": {
            "description": "Account not eligible or replay membership revoked"
          },
          "404": {
            "description": "Original workspace no longer exists"
          },
          "409": {
            "description": "Request ID reused with a different name"
          },
          "419": {
            "description": "CSRF missing or expired"
          },
          "429": {
            "description": "Rate limit; honor Retry-After"
          }
        }
      }
    },
    "/api/auth/getProfile": {
      "post": {
        "operationId": "getProfileAccount",
        "summary": "Read own account profile",
        "description": "Session+CSRF; verified account and current session epoch required. No workspace membership required. Actor always comes from session; ignores supplied userId. Replay is account-scoped and rechecks eligibility before returning stored result. Legacy workspace RPC remains available under its original authorization and receipt namespace.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Safe own-account result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "revision",
                        "name",
                        "email"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string",
                          "format": "email"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or fields"
          },
          "401": {
            "description": "Missing, expired or revoked account session"
          },
          "403": {
            "description": "Account not eligible"
          },
          "409": {
            "description": "Stale revision or conflicting request ID"
          },
          "419": {
            "description": "CSRF missing or expired"
          }
        }
      }
    },
    "/api/auth/updateProfile": {
      "post": {
        "operationId": "updateProfileAccount",
        "summary": "Update own display name with revision and replay protection",
        "description": "Session+CSRF; verified account and current session epoch required. No workspace membership required. Actor always comes from session; ignores supplied userId. Replay is account-scoped and rechecks eligibility before returning stored result. Legacy workspace RPC remains available under its original authorization and receipt namespace.",
        "security": [
          {
            "sessionCookie": [],
            "csrf": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "expectedRevision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "requestId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "required": [
                  "name",
                  "expectedRevision",
                  "requestId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Safe own-account result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "data"
                  ],
                  "properties": {
                    "ok": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "revision"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "revision": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
