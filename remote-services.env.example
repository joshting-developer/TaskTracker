# Copy to ignored root .env; secrets go in the ignored directory below.
COMPOSE_FILE=docker-compose.remote-db.yml
TASKTRACKER_DB_HOST=mysql.example.com
TASKTRACKER_DB_PORT=3306
TASKTRACKER_DB_DATABASE=task_tracker_testing
TASKTRACKER_DB_USERNAME=tasktracker
TASKTRACKER_DB_SECRET_DIR=./.local/remote-mysql
# Put password in <secret-dir>/password. Verify TLS by default.
TASKTRACKER_DB_SSL_VERIFY=true
TASKTRACKER_DB_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Service + environment namespace; use a unique value per environment.
TASKTRACKER_REDIS_NAMESPACE=tasktracker:local
# Local Redis fallback; omit this profile when switching to external Redis.
COMPOSE_PROFILES=local-redis
# TASKTRACKER_REDIS_HOST=redis.example.com
# TASKTRACKER_REDIS_PORT=6379
# TASKTRACKER_REDIS_USERNAME=tasktracker
# TASKTRACKER_REDIS_PASSWORD_FILE=/run/tasktracker-app/redis-password
# TASKTRACKER_REDIS_DB=0
# TASKTRACKER_REDIS_CACHE_DB=0
